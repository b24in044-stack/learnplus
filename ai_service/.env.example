# Supabase Auth/PostgREST/Storage. The publishable key is used with the user's JWT;
# the secret key is restricted to trusted server-side operations.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Groq remains the primary LLM provider. Never expose this key to the browser.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_SERVICE_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
PROVIDER_TIMEOUT_SECONDS=30
MAX_INPUT_CHARACTERS=6000
MAX_OUTPUT_TOKENS=900
MAX_HISTORY_MESSAGES=20
AI_REQUESTS_PER_MINUTE=10

EMBEDDING_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_MAX_DOCUMENT_BYTES=10485760
RAG_MAX_EXTRACTED_CHARACTERS=2000000
RAG_MAX_PAGES=1000
RAG_MAX_CHUNKS=2000
