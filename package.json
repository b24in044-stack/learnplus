{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "server": "node server.js",
    "dev:server": "node server.js",
    "dev:ai": "python -m uvicorn ai_service.app.main:app --host 127.0.0.1 --port 8100",
    "start": "node server.js",
    "start:ai": "python -m ai_service.serve",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=1 && node --test tests/server.test.js tests/clean.test.js tests/academic-repository.test.js tests/ai-proxy.test.js tests/supabase-repository.test.js tests/branch-enrollment.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.0.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4",
    "rimraf": "^6.1.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
