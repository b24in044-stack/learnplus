# Frontend configuration
# Optional. Leave unset to use same-origin /api/v1 in production.
VITE_API_BASE_URL=
VITE_DEMO_MODE=false
# Supabase Auth configuration; the publishable key is safe for browser use.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Express backend configuration
PORT=8000
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HOPS=0
AI_SERVICE_URL=http://127.0.0.1:8100
# Supabase runtime configuration. Keep the secret key server-side only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Server-only faculty registration secret. Do not use a VITE_ prefix.
FACULTY_INVITE_CODE=
# Supabase PostgreSQL connection strings; use the pooled URL at runtime and the direct URL for migrations.
DATABASE_URL=
DIRECT_URL=
# FastAPI AI service; set GROQ_API_KEY only from the newly rotated secret.
# Never use a VITE_ prefix for provider credentials.
AI_SERVICE_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
# Required for live AI requests. Inject via backend environment/secret manager.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
PROVIDER_TIMEOUT_SECONDS=30
AI_REQUESTS_PER_MINUTE=10
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_MAX_DOCUMENT_BYTES=10485760
RAG_MAX_EXTRACTED_CHARACTERS=2000000
RAG_MAX_PAGES=1000
RAG_MAX_CHUNKS=2000
